{
  "permissions": {
    "deny": [
      "Bash(git push* main)",
      "Bash(git push* main *)",
      "Bash(git push*:main*)",
      "Bash(git push*--no-verify*)",
      "Bash(docker:*)",
      "Bash(docker-compose:*)",
      "Bash(open *Docker*)",
      "Bash(open *docker*)",
      "Bash(git push*--force*)",
      "Bash(git push* -f*)",
      "Bash(git push*--mirror*)",
      "Bash(gh pr merge*)",
      "Bash(pkill:*)",
      "Bash(killall:*)"
    ]
  },
  "enabledPlugins": {
    "mattpocock-skills@mattpocock": true,
    "factory@software-factory": false
  },
  "extraKnownMarketplaces": {
    "mattpocock": {
      "source": {
        "source": "github",
        "repo": "mattpocock/skills"
      }
    }
  }
}
